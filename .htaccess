# 保険的防御: 万一ドキュメントルートがプロジェクト直下に誤設定された場合でも、
# 機微なファイル/ディレクトリへの直接アクセスを拒否する。
# 正しくは公開ディレクトリを public/ に設定すること（推奨）。

# --- FTP フラット配置（ドキュメントルート = プロジェクト直下）用の内部ルーティング ---
# CORESERVER V2 は docroot が /public_html/<サブドメイン> に固定のため、SSH でシンボリック
# リンクを張れない場合は「プロジェクト一式をそのフォルダに置く」形になる。
# その場合、全リクエストを実体のある public/ 配下へ内部転送する。
# ※ SSH で docroot を public/ に向けている運用では、この .htaccess は docroot の外側に
#    なり配信されないため、以下の Rewrite は無害（何も起きない）。
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- URL から .php を消す ---
    # 画面のリンクはすべて拡張子なし（/member/directory）で出しているが、
    # 以前に配ったリンクやブックマークが .php 付きで来ることがあるので、
    # その場合だけ拡張子なしへ1回転送して、アドレスバーを揃える。
    #
    # ・判定には THE_REQUEST（ブラウザが送ってきた元のリクエスト行）を使う。
    #   内部転送では書き換わらないため、下の内部転送と往復し続ける事故が起きない。
    # ・GET 以外は転送しない（POST を 301 で転送するとデータが落ちる）。
    # ・外部サービスに登録済みのエンドポイントは .php のまま受ける。
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?]
    RewriteRule ^index\.php$ / [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.php[\s?]
    RewriteCond %{THE_REQUEST} !\s/+(public/)?(webhook|line_webhook|cron|install)\.php[\s?]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L,QSA]

    # 既に public/ 宛ての内部URLは二重付与しない
    RewriteCond %{REQUEST_URI} !^/public/
    # 実ファイル/ディレクトリでも public/ 側を優先（src/ 等は public/ 配下に無いので404=隠蔽）
    RewriteRule ^$ public/index.php [L]

    # プロフィールの短い共有URL（/u/<コード>）。catch-all より前に置くこと。
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^u/([A-Za-z0-9]{4,32})/?$ public/u.php?c=$1 [L,QSA]

    # 拡張子なしのURL（/member/directory 等）を実体の .php につなぐ。
    # 同名の .php が実在するときだけ通すので、無い場所は素通りして404になる。
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1.php -f
    RewriteRule ^([A-Za-z0-9_\-/]+)$ public/$1.php [L,QSA]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>


# ドットファイル（.env 等）を隠す
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 環境設定・DB・ログ・ソース等の拡張子を直接配信しない
<FilesMatch "\.(env|sqlite|sqlite3|db|log|sql|md|lock|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
