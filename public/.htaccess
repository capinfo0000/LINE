# public/ が直接ドキュメントルートになる運用向けの最小防御。
# ドットファイル（.user.ini / .env 等）を配信しない。
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# プロフィールの短い共有URL（/u/<コード>）を u.php へ渡す。
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^u/([A-Za-z0-9]{4,32})/?$ u.php?c=$1 [L,QSA]
</IfModule>
