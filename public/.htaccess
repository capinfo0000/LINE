# public/ が直接ドキュメントルートになる運用向けの最小防御。
# ドットファイル（.user.ini / .env 等）を配信しない。
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- URL から .php を消す（考え方は プロジェクト直下の .htaccess と同じ） ---
    # 判定はすべて THE_REQUEST（ブラウザが送ってきた元のリクエスト行）で行う。
    # REQUEST_URI だと、フラット配置で直下の .htaccess が public/ へ内部転送した後に
    # /public/cron.php へ変わってしまい、下の除外に当たらなくなる（cron が301で空振りする）。
    # GET 以外は転送しない。外部サービスに登録済みのURLは .php のまま受ける。
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+index\.php[\s?]
    RewriteRule ^index\.php$ / [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s/+[^?\s]*\.php[\s?]
    RewriteCond %{THE_REQUEST} !\s/+(public/)?(webhook|line_webhook|cron|install)\.php[\s?]
    RewriteRule ^(.+)\.php$ /$1 [R=301,L,QSA]

    # プロフィールの短い共有URL（/u/<コード>）を u.php へ渡す。
    RewriteRule ^u/([A-Za-z0-9]{4,32})/?$ u.php?c=$1 [L,QSA]

    # 検索エンジン用のサイトマップと、生成AI向けの案内ファイル。
    # ドメインを含むため中身はPHPで作る。決まった名前で配る必要があるのでここで繋ぐ。
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^llms\.txt$ llms.php [L]

    # 拡張子なしのURL（/member/directory 等）を実体の .php につなぐ。
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([A-Za-z0-9_\-/]+)$ $1.php [L,QSA]
</IfModule>
