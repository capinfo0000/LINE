# ===== 運営者の Stripe 設定（単一運営） =====
# 運営の Stripe シークレットキー。入会金はこのアカウントへ直接入金されます。
# まずはテスト用キー（sk_test_ で始まる文字列）で動作確認してください。
# 本番は sk_live_ のキーに差し替えます。
STRIPE_SECRET_KEY=

# ===== 月額サブスク（会費）=====
# Stripe ダッシュボードで作成した「継続(recurring)Price」のID（price_... で始まる）。
# これが課金の基準（金額・周期はStripe側のPriceで決める）。未設定だと申込ページはエラー。
STRIPE_PRICE_ID=
# 申込ページに表示する月額（表示専用・最小通貨単位＝円）。0で非表示。実課金はStripeのPriceが基準。
MONTHLY_FEE_AMOUNT=0

# （旧・買い切り入会金の金額。サブスク移行後は未使用。表示互換のため残置）
JOIN_FEE_AMOUNT=2000

# Stripe Webhook の署名シークレット（whsec_...）。会員化・毎月の課金反映に使用。
# 必要イベント: checkout.session.completed / invoice.paid / customer.subscription.deleted
#              （任意で invoice.payment_failed / customer.subscription.updated）
STRIPE_WEBHOOK_SECRET=

# ===== ポイント制度の付与量（任意・未設定は既定値）=====
# POINTS_REFERRER=100          # 紹介者へ（紹介入会時）
# POINTS_JOINER=50             # 入会者へ（紹介コード入力時）
# POINTS_PRAISE=10             # 評価(good)を受けた時
# POINTS_REPORT_PENALTY=20     # 通報1件あたりの減点
# POINTS_REFERRAL_MONTHLY=50   # 紹介した人が毎月課金継続した時、紹介者へ

# 保存データの暗号化キー（任意・推奨）。base64 の 32 バイト。
# 生成例: php -r 'echo base64_encode(random_bytes(32));'
# ※設定後に変更すると、暗号化済みデータは復号できなくなります。安全に保管を。
APP_KEY=

# このアプリの公開URL。決済完了/中断（success/cancel）・Webhook のリンク生成に使用。
APP_BASE_URL=http://localhost:8000

# 信頼できるリバースプロキシ/CDN の背後で動かす場合のみ 1 にする。
# 1 のとき、送信元IP判定に X-Forwarded-For 先頭を採用する（レート制限の精度向上）。
# 直接公開（プロキシ無し）の場合は 0 のままにすること（XFF 偽装でレート制限を回避されるため）。
TRUSTED_PROXY=0

# SQLite ファイルの場所（任意・既定は data/app.sqlite）。公開フォルダ外の絶対パス推奨。
# DB_PATH=/home/<アカウント>/private/app.sqlite

# 送信メールの差出人（運営者アカウントのパスワード再設定・会員のPW再発行等に使用）。
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=AKマッチング

# 運営者アカウントのオープン登録の可否。単一運営では 0（招待制のみ）を推奨。
# 最初の管理者は `php bin/console.php create-admin <email> <pw>` で作成する。
ALLOW_SIGNUP=0

# メール監査ログ(logs/mail.log)の出力可否（既定 1=出力）。0 で完全無効化。
# 出力する場合も本文・トークン・完全なメールアドレスは記録せず、宛先はマスクします。
MAIL_LOG=1
# メールログのローテーション上限バイト数（既定 5MB）。0 以下で無効。
# MAIL_LOG_MAX_BYTES=5242880

# 監査ログ(audit.log)のローテーション上限バイト数（既定 5MB）。DB と同じ非公開フォルダに出力。
# AUDIT_LOG_MAX_BYTES=5242880

# CAPTCHA（Cloudflare Turnstile）。両方設定すると signup/forgot/ログイン等でボット対策が有効化。
# 未設定なら無効（素通り）。https://dash.cloudflare.com/?to=/:account/turnstile で取得。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ===== 公式LINE（Messaging API）Bot（Phase 3） =====
# LINE Developers コンソールの Messaging API チャネルから取得。
# 未設定なら Bot 送信は無効（Webフローは動作）。Webhook URL は /line_webhook.php。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ===== Zoom（Server-to-Server OAuth・社内利用／Phase 3） =====
# 3つ揃うと予約確定時に会議URLを自動発行。未設定/失敗時は枠だけ確定＋手動URL案内にフォールバック。
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# 会議の自動録画: cloud（クラウド録画・Zoom Pro以上）/ local / none。未設定は cloud。
ZOOM_AUTO_RECORD=cloud

# 予約リマインドを送る「開始までの残り時間」ウィンドウ（秒）。既定3600（1時間前以内）。
# REMIND_WINDOW_SEC=3600
