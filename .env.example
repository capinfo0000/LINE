# ===== あなた（運営者）の Stripe 設定 =====
# あなた自身の Stripe シークレットキー。参加費はこのアカウントへ直接入金されます。
# まずはテスト用キー（sk_test_ で始まる文字列）で動作確認してください。
# 本番は sk_live_ のキーに差し替えます。
STRIPE_SECRET_KEY=

# 保存データの暗号化キー（任意・推奨）。設定すると主催者の Stripe 鍵ファイルを暗号化保存します。
# 未設定でも動作します（その場合、鍵は公開フォルダ外のファイルに平文で保存）。
# base64 の 32 バイト。生成例: php -r 'echo base64_encode(random_bytes(32));'
# ※設定後に変更すると、暗号化済みの登録鍵は復号できなくなります。安全に保管を。
APP_KEY=

# 主催者の Stripe 鍵ファイルの保存ディレクトリ（任意）。未指定なら DB と同じ場所に保存。
# 公開フォルダ外の絶対パスを推奨（例: /home/<アカウント>/private）。
# STRIPE_KEY_DIR=/home/<アカウント>/private

# Webhook の署名シークレット（任意。現状の決済フローでは未使用でも動作します）。
STRIPE_WEBHOOK_SECRET=

# Stripe Connect の client_id（ca_... 形式）。設定すると主催者が各自の Stripe を接続でき、
# 参加費の入金・名簿(PII)・決済データが主催者ごとに物理分離されます（推奨）。
# 未設定なら従来どおりプラットフォームの STRIPE_SECRET_KEY を直接使用します（後方互換）。
# 取得: Stripe ダッシュボード → Connect → 設定 → OAuth の client_id
STRIPE_CONNECT_CLIENT_ID=

# このアプリの公開URL。決済完了/中断（success/cancel）のリンク生成に使用。
APP_BASE_URL=http://localhost:8000

# 信頼できるリバースプロキシ/CDN の背後で動かす場合のみ 1 にする。
# 1 のとき、送信元IP判定に X-Forwarded-For 先頭を採用する（レート制限の精度向上）。
# 直接公開（プロキシ無し）の場合は 0 のままにすること（XFF 偽装でレート制限を回避されるため）。
TRUSTED_PROXY=0

# SQLite ファイルの場所（任意・既定は data/app.sqlite）
# DB_PATH=/var/data/app.sqlite

# 送信メールの差出人（パスワード再設定・申込確認メールに使用）
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=イベント事前決済

# 新規登録（オープン登録）の受付可否。単独運営に切り替えるなら 0 で閉じられる（既定: 1=受付）。
ALLOW_SIGNUP=1

# メール監査ログ(logs/mail.log)の出力可否（既定 1=出力）。0 で完全無効化。
# 出力する場合も本文・トークン・完全なメールアドレスは記録せず、宛先はマスク（y***@example.com）します。
MAIL_LOG=1
# メールログのローテーション上限バイト数（既定 5MB）。0 以下で無効。
# MAIL_LOG_MAX_BYTES=5242880

# 監査ログ(audit.log)のローテーション上限バイト数（既定 5MB）。DB と同じ非公開フォルダに出力。
# 記録: 日時/IP/UA/操作種別（ログイン成否・鍵保存/削除・返金・CSV出力・越権拒否・CSRF失敗 等）。秘密は記録しません。
# AUDIT_LOG_MAX_BYTES=5242880

# CAPTCHA（Cloudflare Turnstile）。両方設定すると signup/forgot/申込フォームでボット対策が有効化。
# 未設定なら無効（素通り）。https://dash.cloudflare.com/?to=/:account/turnstile で取得。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
